@page "/cards/game/join"

@using Humanizer
@using Karata.Kit.Cards
@using Karata.Kit.Cards.Models
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication

@attribute [Authorize]

@inject Client Cards
@inject NavigationManager Navigator

<MudContainer MaxWidth="MaxWidth.Large" Class="mud-height-full">
    <MudText Typo="Typo.h5" Class="pa-4 my-4">Join or create a game room to play.</MudText>

    <MudPaper Class="pa-4 mb-4" Elevation="0">
        <MudTextField @bind-Value="_link" Label="Room code" Variant="Variant.Filled" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Rounded.Abc" Class="mb-4" />
        <MudButton Disabled="@_loading" Href="@JoinLink" Variant="Variant.Outlined" Color="Color.Primary">
            <MudText>Join game</MudText>
        </MudButton>
        <MudButton Disabled="@_loading" Href="@SpectateLink" Variant="Variant.Outlined" Color="Color.Secondary" Class="ml-2">
            <MudText>Spectate</MudText>
        </MudButton>
    </MudPaper>

    <MudPaper Class="pa-4 mb-4" Elevation="0">
        <MudToggleGroup CheckMark Outlined T="RoomVisibility" Delimiters="false" @bind-Value="_visibility" Class="mb-4" SelectedClass="toggle-group-selected-text-primary">
            @foreach (var visibility in Enum.GetValues<RoomVisibility>())
            {
                <MudToggleItem Value="@visibility" Text="@visibility.Humanize()" SelectedIcon="@Icons.Material.Rounded.Check" UnselectedIcon="@visibility.Icon" />
            }
        </MudToggleGroup>
        <MudButton Disabled="@_loading" OnClick="@CreateRoom" Variant="Variant.Outlined" Color="Color.Secondary">
            @if (_loading)
            {
                <MudProgressCircular Indeterminate Class="ms-n1" Size="Size.Small" />
                <MudText Class="ms-2">Creating game</MudText>
            }
            else
            {
                <MudText>Create game</MudText>
            }
        </MudButton>
    </MudPaper>

    <MudPaper Class="pa-4 mb-4" Elevation="0">
        <MudList T="string">
            <MudListSubheader>Available Games</MudListSubheader>

            @if (_rooms is [..])
            {
                @foreach (var room in _rooms)
                {
                    <MudListItem Text="@room.Id.ToString()" SecondaryText="@($"Created at {room.CreatedAt.ToLocalTime()}")" Href="@($"/game/{room.Id}")"/>
                }
            }
            else
            {
                @foreach (var _ in Enumerable.Range(0, 5))
                {
                    <MudListItem>
                        <MudSkeleton Animation="Animation.Wave" Width="40%"/>
                        <MudSkeleton Animation="Animation.Wave" Width="30%"/>       
                    </MudListItem>
                }
            }
        </MudList>
    </MudPaper>
</MudContainer>

@code {
    private bool _loading;
    private List<RoomData>? _rooms;
    private string _link = string.Empty;
    private RoomVisibility _visibility;

    private string JoinLink => $"/cards/game/{_link}/play";
    private string SpectateLink => $"/cards/game/{_link}/spectate";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _rooms = await Cards.Rooms.ListAsync();
        }
        catch (AccessTokenNotAvailableException)
        {
            Console.WriteLine("Redirecting you to login");
        }
    }

    private async Task CreateRoom()
    {
        try
        {
            _loading = true;
            var room = await Cards.Rooms.CreateAsync(new RoomRequest(_visibility));
            Navigator.NavigateTo($"/cards/game/{room.Id.ToString()}/play");
        }
        finally
        {
            _loading = false;
        }
    }
}