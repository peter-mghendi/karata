@page "/cards/game/{id:guid}/spectate"

@using System.Reactive.Disposables
@using System.Reactive.Disposables.Fluent
@using Karata.Kit.Cards
@using Karata.Kit.Cards.Connection
@using Karata.Kit.Cards.Models
@using Karata.Kit.Cards.State
@using Karata.Pebble.Interceptors
@using Karata.Surface.Models
@using Microsoft.Extensions.Options

@implements IDisposable

@inject ILoggerFactory LoggerFactory
@inject IOptions<Client.Options> ClientOptions
@inject ISnackbar Snackbar
@inject Client KarataCardsClient
@inject NavigationManager Navigator

<PageTitle>Spectating</PageTitle>

<SessionGuard Session="_session">
    <MudLoading Loading="@(_store is null)" Text="Please wait..." Class="mud-height-full pa-0">
        <MudContainer MaxWidth="MaxWidth.Medium" Class="py-6">
            @if (_store is not null)
            {
                var room = _store.State;
                var game = room.Game;

                <MudStack Spacing="3">
                    <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap"
                              Spacing="2">
                        <div>
                            <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Rounded.Visibility" Color="Color.Info"
                                         Size="Size.Small"/>
                                <MudText Typo="Typo.overline" Class="mud-text-secondary">Spectating</MudText>
                            </MudStack>
                            <MudText Typo="Typo.h5">@($"{room.Administrator.Username}'s room")</MudText>
                        </div>

                        <MudStack Row Spacing="1">
                            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Rounded.MenuBook"
                                       Href="/cards/rules" Target="_blank">
                                Rules
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Rounded.ArrowBack"
                                       Href="@($"/cards/game/{room.Id}")">
                                Room details
                            </MudButton>
                        </MudStack>
                    </MudStack>

                    @if (game.Status is GameStatus.Ongoing && game.Hands.Count > game.CurrentTurn)
                    {
                        <GameStatusBar Game="game"/>
                    }
                    else if (game.Status is GameStatus.Lobby)
                    {
                        <MudPaper Outlined Class="pa-6 rounded-lg">
                            <MudStack AlignItems="AlignItems.Center" Spacing="2">
                                <MudProgressCircular Indeterminate Color="Color.Info"/>
                                <MudText Typo="Typo.h6">Waiting for the game to start</MudText>

                                <MudStack Row Justify="Justify.Center" Wrap="Wrap.Wrap" Spacing="1">
                                    @foreach (var hand in game.Hands.Where(h => h.Status is HandStatus.Active))
                                    {
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                                 Icon="@Icons.Material.Rounded.Person">
                                            @hand.Username
                                        </MudChip>
                                    }
                                </MudStack>

                                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                    @game.Hands.Count(h => h.Status is HandStatus.Active) of @MaxPlayers players have joined
                                </MudText>
                            </MudStack>
                        </MudPaper>
                    }

                    <MudText Typo="Typo.h6" Class="mt-2">Activity</MudText>

                    @if (_failed)
                    {
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                            Couldn't load the activity log.
                        </MudAlert>
                    }
                    else if (!_loaded)
                    {
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="8rem" Class="rounded-lg"/>
                    }
                    else if (_entries.Count == 0)
                    {
                        <MudText Class="mud-text-secondary">Nothing has happened yet.</MudText>
                    }
                    else
                    {
                        <MudPaper Outlined Class="rounded-lg">
                            @foreach (var entry in Visible)
                            {
                                <MudStack Row AlignItems="AlignItems.Start" Spacing="3" Class="pa-3">
                                    <MudAvatar Size="Size.Small" Variant="Variant.Outlined" Color="@entry.Color">
                                        <MudIcon Icon="@entry.Icon" Size="Size.Small"/>
                                    </MudAvatar>

                                    <MudStack Spacing="1" Class="flex-grow-1" Style="min-width: 0;">
                                        <MudText>
                                            @if (entry.Player is not null)
                                            {
                                                <b>@entry.Player</b>
                                            }
                                            &nbsp;@entry.Text
                                        </MudText>

                                        @if (entry.Cards.Count > 0 || entry.Notes.Count > 0)
                                        {
                                            <MudStack Row Wrap="Wrap.Wrap" Spacing="1">
                                                @foreach (var card in entry.Cards)
                                                {
                                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                                             Icon="@GetIcon(card)"
                                                             Color="@(card.Color is Red ? Color.Error : Color.Default)">
                                                        @card.Name
                                                    </MudChip>
                                                }

                                                @foreach (var note in entry.Notes)
                                                {
                                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                                                             Color="Color.Info">
                                                        @note
                                                    </MudChip>
                                                }
                                            </MudStack>
                                        }
                                    </MudStack>

                                    <MudText Typo="Typo.caption" Class="mud-text-secondary"
                                             Style="white-space: nowrap;">
                                        @entry.At.LocalDateTime.ToString("t")
                                    </MudText>
                                </MudStack>

                                <MudDivider/>
                            }

                            @if (!_all && _entries.Count > Recent)
                            {
                                <MudButton Variant="Variant.Text" FullWidth OnClick="@(() => _all = true)">
                                    Show @(_entries.Count - Recent) earlier
                                </MudButton>
                            }
                        </MudPaper>
                    }
                </MudStack>
            }
        </MudContainer>
    </MudLoading>
</SessionGuard>

@code
{
    private const int MaxPlayers = 4;
    private const int Recent = 30;

    [Parameter] public Guid Id { get; set; }

    private SpectatorConnection.Session? _session;
    private RoomStore? _store;
    private List<Entry> _entries = [];
    private bool _loaded;
    private bool _failed;
    private bool _all;
    private bool _refreshing;
    private bool _stale;
    private readonly CompositeDisposable _subscriptions = new();

    private IEnumerable<Entry> Visible => _all ? _entries : _entries.Take(Recent);

    private void OnStoreChanged(RoomData room) => StateHasChanged();

    protected override async Task OnInitializedAsync()
    {
        await RefreshTurnsAsync();

        var connection = new SpectatorConnection(ClientOptions.Value.Host);
        await connection.StartAsync();

        _session = connection.Spawn(Id, new SpectatorConnection.SessionParameters());

        _session.Events.AddHandToRoom.Subscribe(data =>
        {
            var (_, user, _) = data;
            Snackbar.Add($"{user.Username} has joined the room", Severity.Info, c => c.SnackbarVariant = Variant.Text);
        }).DisposeWith(_subscriptions);

        _session.Events.AddToRoom.Subscribe(room =>
        {
            if (room.Game.Status is GameStatus.Over)
            {
                Navigator.NavigateTo($"/cards/game/{room.Id}/results");
                return;
            }

            _store = new RoomStore(room, [
                new LoggingInterceptor<RoomData>(LoggerFactory),
                new TimingInterceptor<RoomData>(LoggerFactory)
            ]);
            _store.Changes.Subscribe(OnStoreChanged).DisposeWith(_subscriptions);

            _session.Events.BindRoomState(_store).DisposeWith(_subscriptions);
            OnStoreChanged(room);
        }).DisposeWith(_subscriptions);

        _session.Events.TurnCommitted
            .Subscribe(game => _ = RefreshTurnsAsync())
            .DisposeWith(_subscriptions);

        _session.Events.EndGame
            .Subscribe(_ => Navigator.NavigateTo($"/cards/game/{Id}/results"))
            .DisposeWith(_subscriptions);

        _session.Events.SystemMessage.Subscribe(ShowMessage).DisposeWith(_subscriptions);

        _session.Events.RemoveFromRoom
            .Subscribe(_ =>
            {
                _session.Dispose();
                _store?.Dispose();

                StateHasChanged();

                Navigator.NavigateTo("/cards/game/join");
            })
            .DisposeWith(_subscriptions);

        _session.Events.RemoveHandFromRoom
            .Subscribe(handId =>
            {
                var hand = _store!.State.Game.Hands.Find(h => h.Id == handId)!;
                Snackbar.Add($"{hand.Username} has left the room.", Severity.Info, c => c.SnackbarVariant = Variant.Text);
            })
            .DisposeWith(_subscriptions);

        _session.Events.UpdateGameStatus
            .Subscribe(game =>
            {
                if (game.Status is GameStatus.Over) return;

                Snackbar.Add($"The game is now {game.Status.ToString().ToLower()}.", Severity.Info, c => c.SnackbarVariant = Variant.Text);
                _ = RefreshTurnsAsync();
            })
            .DisposeWith(_subscriptions);

        _session.Events.UpdateHandStatus.Subscribe(data =>
        {
            var (handId, status) = data;
            var hand = _store!.State.Game.Hands.Find(h => h.Id == handId)!;
            Snackbar.Add($"{hand.Username} has {status.ToString().ToLower()}.", Severity.Info, c => c.SnackbarVariant = Variant.Text);
        }).DisposeWith(_subscriptions);

        await _session.JoinRoom();
    }

    private async Task RefreshTurnsAsync()
    {
        if (_refreshing)
        {
            _stale = true;
            return;
        }

        _refreshing = true;
        try
        {
            do
            {
                _stale = false;
                _entries = BuildEntries(await KarataCardsClient.Turns.ListAsync(Id));
                _loaded = true;
                _failed = false;
                StateHasChanged();
            } while (_stale);
        }
        catch (Exception)
        {
            _failed = !_loaded;
            StateHasChanged();
        }
        finally
        {
            _refreshing = false;
        }
    }

    private static List<Entry> BuildEntries(List<TurnData> turns)
    {
        var entries = turns
            .Where(turn => turn.Type is TurnType.Play or TurnType.Void)
            .OrderByDescending(turn => turn.CreatedAt)
            .ThenByDescending(turn => turn.Id)
            .Select(Describe)
            .ToList();

        var deals = turns.Where(turn => turn.Type is TurnType.Deal).ToList();
        if (deals.Count > 0)
        {
            var counts = deals.Select(turn => turn.CardsPicked.Count).Distinct().ToList();
            var text = counts is [var each] ? $"{CardCount(each)} dealt to each player." : "Cards dealt.";

            entries.Add(new Entry(null, Icons.Material.Rounded.Style, Color.Info, $"Game started. {text}",
                deals.Min(turn => turn.CreatedAt), [], []));
        }

        return entries;
    }

    private static Entry Describe(TurnData turn)
    {
        var player = turn.Hand.Username;

        if (turn.Type is TurnType.Void)
        {
            return new Entry(player, Icons.Material.Rounded.PersonOff, Color.Default, "was skipped (away).",
                turn.CreatedAt, [], []);
        }

        var played = turn.CardsPlayed.Count;
        var picked = turn.CardsPicked.Count;

        var text = (played, picked) switch
        {
            (> 0, > 0) => $"played {CardCount(played)} and picked {CardCount(picked)}.",
            (> 0, _) => $"played {CardCount(played)}.",
            (_, > 0) => $"picked {CardCount(picked)}.",
            _ => "took no action."
        };

        return new Entry(
            player,
            played > 0 ? Icons.Material.Rounded.Style : Icons.Material.Rounded.PostAdd,
            played > 0 ? Color.Primary : Color.Warning,
            text,
            turn.CreatedAt,
            [.. turn.CardsPlayed],
            TurnNotes(turn)
        );
    }

    private static List<string> TurnNotes(TurnData turn)
    {
        var notes = new List<string>();

        if (turn.Delta is { } delta)
        {
            if (delta.Reverse) notes.Add("Reversed direction");

            if (delta.Skip == 0) notes.Add("Plays again");
            else if (delta.Skip > 1) notes.Add($"Skips {delta.Skip - 1} {(delta.Skip == 2 ? "player" : "players")}");

            if (delta.RemoveRequestLevels > 0) notes.Add("Countered the request");

            if (delta.RequestLevel is not CardRequestLevel.NoRequest && turn.Request is { } request)
            {
                notes.Add($"Requested {(request.Face is None ? request.Suit.ToString() : request.Name)}");
            }

            if (delta.Give > 0) notes.Add($"Next player picks {delta.Give}");
        }

        if (turn.IsLastCard) notes.Add("Last card!");

        return notes;
    }

    private static string CardCount(int num) => $"{num} {(num == 1 ? "card" : "cards")}";

    private static string GetIcon(Card card) => card.Suit switch
    {
        Spades => CardIcons.Spade,
        Hearts => CardIcons.Heart,
        Clubs => CardIcons.Club,
        Diamonds => CardIcons.Diamond,
        BlackJoker or RedJoker => Icons.Material.Rounded.TheaterComedy,
        _ => throw new ArgumentException($"Invalid suit {card.Suit}", nameof(card))
    };

    private void ShowMessage(SystemMessage message)
    {
        var severity = message.Type switch
        {
            MessageType.Error => Severity.Error,
            MessageType.Info => Severity.Info,
            MessageType.Success => Severity.Success,
            MessageType.Warning => Severity.Warning,
            _ => throw new ArgumentException("Invalid message type.", nameof(MessageType))
        };
        Snackbar.Add(message.Text, severity, c => c.SnackbarVariant = Variant.Text);
    }

    public void Dispose()
    {
        _subscriptions.Dispose();
        _store?.Dispose();
    }
    
    private sealed record Entry(
        string? Player,
        string Icon,
        Color Color,
        string Text,
        DateTimeOffset At,
        List<Card> Cards,
        List<string> Notes
    );
}