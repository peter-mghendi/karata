@page "/trivia/game/{Identifier:guid}/results"

@using BlafettisLib
@using Howler.Blazor.Components
@using Karata.Kit.Platform.Models
@using Karata.Kit.Trivia
@using Karata.Kit.Trivia.Models
@using Karata.Web.Extensions

@inject AuthenticationStateProvider Authenticator
@inject IHowl Howl
@inject Client QuizWars

<PageTitle>Game Over</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large">
    <MudStack>
        <Blafettis @ref="@_blafettis" spread="90"/>

        @* HACK: Should not need to check for Me being null here *@
        @if (Game is null || Me is null || Rounds is { Count: 0 })
        {
            <MudText>Loading...</MudText>
        }
        else
        {
            <MudCard Class="rounded-lg">
                <MudCardMedia Image="@Game.Topic.GetImageUrl()"/>
                <MudCardContent>
                    <MudStack AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.h4">@Game.Topic.Title</MudText>
                        <MudText>@Game.Topic.Description</MudText>
                        <MudGrid Class="mb-4">
                            @foreach (var player in Game.Players)
                            {
                                <MudItem xs="6">
                                    <PlayerDisplay Player="@player" Rounds="@Rounds" Me="@Me"/>
                                </MudItem>
                            }
                        </MudGrid>

                        <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary)">@Game.Id</MudText>
                    </MudStack>
                </MudCardContent>
            </MudCard>

            <MudCard Class="rounded-lg pb-6">
                <MudCardHeader>
                    <MudText Typo="Typo.h5">Questions</MudText>
                    <MudSpacer/>
                    <MudIconButton Icon="@Icons.Material.Rounded.Share"/>
                    <MudIconButton Icon="@Icons.Material.Rounded.Flag" Color="Color.Error"/>
                </MudCardHeader>

                @* HACK: The height hack will not work for longer questions and answers. *@
                <MudCarousel ItemsSource="Rounds" Class="mud-width-full" Style="height:25rem;" AutoCycle EnableSwipeGesture
                             ShowArrows ShowBullets>
                    <ItemTemplate>
                        <MudCard Class="rounded-lg px-8" Elevation="0">
                            <MudCardHeader>
                                <MudText Typo="Typo.h6">
                                    @(context.Index + 1)/@(Rounds.Count) : @(context.Question.Text)
                                </MudText>
                            </MudCardHeader>
                            <MudCardContent>
                                <MudRadioGroup Value="@(context.Answer?.Id ?? -1)" ReadOnly>
                                    <MudStack>
                                        @foreach (var choice in context.Question.Choices)
                                        {
                                            <MudRadio Color="@(context.IsAnswer(choice) ? Color.Success : Color.Default)"
                                                      Value="@choice.Id">
                                                <MudText Color="@(context.IsAnswer(choice) ? Color.Success : Color.Default)"
                                                         Class="me-2" Style="vertical-align: middle" Inline>
                                                    @choice.Text
                                                </MudText>

                                                @* O(n²) :( *@
                                                @foreach (var response in context.Responses.Where(response => choice.Id == response.Choice?.Id))
                                                {
                                                    <MudChip T="string" Color="@(context.IsAnswer(choice) ? Color.Success : Color.Error)"
                                                             Variant="@Variant.Text">
                                                        @response.User.Username
                                                    </MudChip>
                                                }
                                            </MudRadio>
                                        }
                                    </MudStack>
                                </MudRadioGroup>
                            </MudCardContent>
                        </MudCard>
                    </ItemTemplate>
                </MudCarousel>
            </MudCard>

            <MudCard Class="rounded-lg">
                <MudCardHeader>
                    <MudText Typo="Typo.h5">Scoring</MudText>
                </MudCardHeader>

                <MudCardContent>
                    <MudChart ChartType="ChartType.Line" ChartSeries="@Series" ChartLabels="@Labels" Width="100%"
                              Height="350px" ChartOptions="@Options" @bind-SelectedIndex="_index" CanHideSeries/>
                </MudCardContent>
            </MudCard>
        }
    </MudStack>
</MudContainer>

@code {
    private int _index = -1;

    private string _username = null!;

    private Blafettis? _blafettis;

    [Parameter] public Guid Identifier { get; set; }

    private GameData? Game { get; set; }

    private List<RoundData> Rounds { get; set; } = [];

    private UserData? Me => Game?.Players.SingleOrDefault(player => player.Username == _username);

    private List<ChartSeries<double>> Series => [..Game!.Players.Select(PlayerSeries)];

    private static readonly string[] Labels = Enumerable.Range(0, 8).Select(x => x.ToString()).ToArray();

    private static readonly LineChartOptions Options = new() { YAxisTicks = 20, MaxNumYAxisTicks = 8 };

    protected override async Task OnInitializedAsync()
    {
        var auth = await Authenticator.GetAuthenticationStateAsync();
        _username = auth.User.Identity!.Name!;

        Game = await QuizWars.Games.FetchAsync(Identifier);
        Rounds = await QuizWars.Rounds.GetRounds(Identifier);

        if (Winners() is [{ Id: var winnerId }] && winnerId == Me!.Id)
        {
            // await Howl.Play("/audio/win.mp3"); // Requires user interaction to play.
            _blafettis?.RaiseConfetti();
        }
    }

    private ChartSeries<double> PlayerSeries(UserData player)
    {
        var data = Rounds
            .SelectMany(round => round.Responses.Where(response => response.User.Id == player.Id),
                (round, response) => new { round.Index, response.Points })
            .OrderBy(item => item.Index)
            .GroupBy(item => item.Index)
            .TakeWhile(group => group.Key == group.First().Index)
            .OrderBy(group => group.Key)
            .Aggregate(new List<double> { 0 }, (acc, group) =>
            {
                acc.Add(acc.Last() + group.Sum(item => item.Points));
                return acc;
            })
            .ToArray();

        return new ChartSeries<double> { Name = player.Username, Data = data };
    }

    private UserData[] Winners() => Rounds.Any(r => r.Responses.Count < Game!.Players.Length) switch
    {
        true => [.. Game!.Players.GroupBy(Points).MaxBy(x => x.Key)!],
        false => []
    };

    private int Points(UserData player) => Rounds
        .SelectMany(r => r.Responses)
        .Where(r => r.User.Id == player.Id)
        .ToList().Sum(r => r.Points);
}