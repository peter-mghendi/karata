@page "/trivia"

@using Karata.Kit.Trivia
@using Karata.Kit.Trivia.Models
@using Karata.Surface.Components.Trivia.Dialogs
@using Karata.Web.Extensions

@attribute [Authorize]

@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject Client Trivia

<PageTitle>Home</PageTitle>

<MudGrid>
    @foreach (var topic in Topics)
    {
        <MudItem xs="6" sm="4" md="3">
            <MudCard Class="rounded-lg">
                <MudCardMedia Image="@topic.GetImageUrl()"/>
                <MudCardHeader>@topic.Title</MudCardHeader>
                <MudCardContent>@topic.Description</MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => Play(topic))">
                        Play!
                    </MudButton>
                    <MudIconButton Icon="@Icons.Material.Filled.Favorite" Color="Color.Error"/>
                    <MudIconButton Icon="@Icons.Material.Filled.Share" Color="Color.Default"/>
                </MudCardActions>
            </MudCard>
        </MudItem>
    }
</MudGrid>

@code
{
    private List<TopicResponse> Topics { get; set; } = [];

    protected override async Task OnInitializedAsync()
    {
        Topics = await Trivia.Topics.GetTopics();
    }

    private async Task Play(TopicResponse topic)
    {
        var opponent = await SelectUser();
        if (opponent is null)
        {
            return;
        }

        var request = new GameRequest(topic.Id, opponent);
        var game = await Trivia.Games.CreateGame(request);

        Navigation.NavigateTo($"trivia/game/{game.Id}/play");
    }

    private async Task<string?> SelectUser()
    {
        var dialog = await DialogService.ShowAsync<SelectUserDialog>("Select Opponent");
        var result = await dialog.Result;

        return result?.Data as string;
    }
}