<img class="card @(Disabled ? null : "cursor-pointer")"
     src="@Assets[Card.ImageSource(faceUp: FaceUp)]"
     alt="@(FaceUp ? Card.Name : "Face-down card")"
     role="@(Disabled ? null : "button")"
     tabindex="@(Disabled ? null : "0")"
     @onclick="Click"
     @onkeydown="KeyDown"/>

@code {
    [Parameter] public Card Card { get; set; } = null!;

    [Parameter] public bool FaceUp { get; set; }

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public EventCallback<Card> OnClick { get; set; }

    private async Task Click()
    {
        if (!Disabled) await OnClick.InvokeAsync(Card);
    }

    private async Task KeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " ") await Click();
    }

}