@using Karata.Kit.Cards.Models

@implements Karata.Surface.Models.IPlayerInterface

<div id="table" class="mud-width-full mud-height-full relative teal rounded mud-elevation-1">
    <div id="bottom" class="absolute @(MyTurn ? "seat-active" : null)">
        <HandComponent FaceUp Cards="@CurrentHand" OnCardSelected="AddCardToTurn"/>
    </div>

    <div id="turn" class="absolute">
        <HandComponent FaceUp Cards="@Turn" OnCardSelected="RemoveCardFromTurn"/>
    </div>

    @for (var i = 0; i < OtherHands.Count && i < Seats.Length; i++)
    {
        var hand = OtherHands[i];
        var active = Game.CurrentHand.Id == hand.Id;

        <div id="@Seats[i]" class="@(i == 2 ? "hand-container" : "absolute") @(active ? "seat-active" : null)"
             title="@($"{hand.Username}: {hand.Cards.Count} cards")">
            <HandComponent Cards="@hand.Cards.ToImmutableList()"/>
        </div>
    }

    <img id="deck" class="absolute" src="@Assets["img/cards/Back.svg"]" alt="Card back" title="@($"Cards to pick: {Game.Pick}")"/>
    <img id="pile" class="absolute" src="@Assets[Game.Pile.Peek().ImageSource(faceUp: true)]" alt="@Game.Pile.Peek().Name" title="@RequestText"/>
</div>

@code
{
    [Parameter] public GameData Game { get; set; } = null!;

    [Parameter] public HandData Hand { get; set; } = null!;

    [Parameter] public ImmutableList<Card> Turn { get; set; } = ImmutableList<Card>.Empty;

    [Parameter] public EventCallback<ValueTuple<Card, int>> OnAddCardToTurn { get; set; }

    [Parameter] public EventCallback<ValueTuple<Card, int>> OnReorderCardInTurn { get; set; }

    [Parameter] public EventCallback<Card> OnRemoveCardFromTurn { get; set; }

    private static readonly string[] Seats = ["top", "left", "right"];

    private bool MyTurn => Game.CurrentHand.Id == Hand.Id;

    private ImmutableList<Card> CurrentHand => [.. Hand.Cards.Where(c => !Turn.Contains(c))];

    private List<HandData> OtherHands => [.. Game.Hands.Where(h => h.Id != Hand.Id)];

    private string RequestText => Game.Request switch
    {
        { Face: None } => Game.Request.ToString(),
        { Face: not None } => Game.Request.Name,
        null => "No card has been requested",
    };

    private async Task AddCardToTurn(Card card) => await OnAddCardToTurn.InvokeAsync((card, Turn.Count));

    private async Task RemoveCardFromTurn(Card card) => await OnRemoveCardFromTurn.InvokeAsync(card);
}