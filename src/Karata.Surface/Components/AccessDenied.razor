@inject NavigationManager Navigator

<MudStack AlignItems="AlignItems.Center" Spacing="2" Class="mt-16">
    <MudIcon Icon="@Icons.Material.Rounded.Lock" Color="Color.Warning" Style="font-size: 4rem;"/>

    <MudText Typo="Typo.h4">Access denied</MudText>

    <MudText Color="Color.Secondary" Align="Align.Center">
        @if (User is not null)
        {
            <span>You're signed in as <b>@User</b>, but your account doesn't have permission to view this page.</span>
        }
        else
        {
            <span>Your account doesn't have permission to view this page.</span>
        }
    </MudText>

    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-4">
        @_path
    </MudText>

    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Rounded.Home"
               Href="/">
        Go to Home
    </MudButton>
</MudStack>

@code {
    [Parameter] public string? User { get; set; }

    private string _path = "";

    protected override void OnInitialized() => _path = "/" + Navigator.ToBaseRelativePath(Navigator.Uri);
}