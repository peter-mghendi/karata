<div class="d-flex mud-height-full">
    <div class="d-flex flex-column flex-grow-1 justify-center align-self-center align-center ma-8">
        <MudText Typo="Typo.h3" Class="mb-4">Game Over!</MudText>
        <MudText Typo="Typo.h5">@(Room.Game.Result?.Reason)</MudText>
        <MudSpacer></MudSpacer>
        <MudText Typo="Typo.caption">Room ID: @(Room.Id)</MudText>
    </div>
</div>

@code {
    [Parameter] public required RoomData Room { get; set; }
}