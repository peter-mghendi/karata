@using Karata.Surface.Security

@inherits LayoutComponentBase

@inject AuthenticationHelper Authenticator
@inject ILocalStorageService LocalStorage
@inject NavigationManager Navigator

<MudThemeProvider @ref="_themer" @bind-IsDarkMode="@_dark" Theme="_theme"/>
<MudPopoverProvider/>
<MudDialogProvider/>
<MudSnackbarProvider/>

<MudLayout Class="mud-height-full">
    <div style="min-height: 100%; display: grid; grid-template-rows: 1fr auto;">
        <MudAppBar Elevation="0" Style="background-color: var(--mud-palette-background-gray);">
            <MudLink Href="/" Typo="Typo.body1" Color="Color.Default" Class="me-4" Underline="Underline.None">
                karata
            </MudLink>
            <MudLink Href="/cards/game/join" Typo="Typo.body2" Class="me-4" Color="Color.Default">
                cards
            </MudLink>
            <MudLink Href="/trivia" Typo="Typo.body2" Class="me-4" Color="Color.Default">
                trivia
            </MudLink>
            <MudSpacer/>
            <AuthorizeView>
                <Authorized>
                    <MudLink OnClick="@(() => Navigator.NavigateTo($"users/{context.User.Identity!.Name!}"))" Typo="Typo.body2"
                             Class="me-4">
                        hi, @context.User.Identity!.Name!
                    </MudLink>
                    <MudLink OnClick="@(() => Authenticator.Logout())" Typo="Typo.body2" Class="me-4"
                             Color="Color.Error">
                        end session
                    </MudLink>
                </Authorized>
                <NotAuthorized>
                    <MudLink OnClick="@(() => Authenticator.Register())" Typo="Typo.body2" Class="me-4"
                             Color="Color.Default">
                        register
                    </MudLink>
                    <MudLink OnClick="@(() => Authenticator.Login())" Typo="Typo.body2" Class="me-2"
                             Color="Color.Primary">
                        log in
                    </MudLink>
                </NotAuthorized>
            </AuthorizeView>
            <MudIconButton Icon="@ThemeToggleIcon" Color="@Color.Default" OnClick="@OnToggleThemeAsync"/>
        </MudAppBar>
        <MudMainContent Class="mud-height-full" Style="position: relative">
            <div>
                @Body
            </div>
        </MudMainContent>
    </div>
    <LegaleseFooter/>
</MudLayout>

@code
{
    private bool _dark;
    private readonly MudTheme _theme = new();
    private MudThemeProvider _themer = null!;

    private string ThemeToggleIcon => _dark switch
    {
        true => Icons.Material.Rounded.LightMode,
        false => Icons.Material.Rounded.DarkMode,
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dark = await LocalStorage.GetItemAsync<bool?>("karata:settings:dark") ?? await _themer.GetSystemDarkModeAsync();
            StateHasChanged();
        }
    }

    private async Task OnToggleThemeAsync()
    {
        await LocalStorage.SetItemAsync("karata:settings:dark", !_dark);
        _dark = !_dark;

        StateHasChanged();
    }
}
